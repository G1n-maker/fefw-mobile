new file mode 100644
index 0000000..ff5dd91
--- /dev/null
+++ b/dm/ios/Sources/L10n.swift
@@ -0,0 +1,33 @@
+// Localisation for the launcher's own chrome (the settings window's tabs, buttons and notes).
+// The setting rows' labels and options come from the game's launcher.json, whose text is the host's
+// (dm/games/settings.tsv); those are localised the same way by their English text as key.
+//
+// Keys are the English strings themselves, so a build with no table falls back to English and a
+// missing entry is visible rather than blank. The table lives in Resources/<lang>.lproj/Localizable.strings,
+// packed by dm/mac/pack_app.py; see tools/README.md for the list of keys.
+import Foundation
+
+private final class BundleAnchor {}
+
+enum L10n {
+    // The bundle holding this app's .lproj folders: the Swift sources are linked into the launcher
+    // executable (pack_app.py), so Bundle.main is the app and its Resources hold the tables.
+    private static let bundle = Bundle.main
+
+    // The language the app runs in: the first of the user's preferred languages that has a table,
+    // else English. Read once; the launcher never changes its language mid-run.
+    private static let table: [String: String] = {
+        let available = Set(bundle.localizations)   // a set: localizations can list a language twice
+        let wanted = Bundle.preferredLocalizations(from: Array(available))
+        let lang = wanted.first ?? "en"
+        guard let path = bundle.path(forResource: "Localizable", ofType: "strings", inDirectory: nil, forLocalization: lang),
+              let d = NSDictionary(contentsOfFile: path) as? [String: String] else { return [:] }
+        return d
+    }()
+
+    /// The translation of an English phrase, or the phrase itself when there is none.
+    static func t(_ en: String) -> String { table[en] ?? en }
+}
+
+/// Shorthand: `L("Play")`.
+func L(_ en: String) -> String { L10n.t(en) }
